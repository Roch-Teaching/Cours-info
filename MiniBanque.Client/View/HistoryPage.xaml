<Page
    x:Class="MiniBanque.Client.View.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiniBanque.Client.View"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20" Margin="0,0,0,24">
            <Button Click="OnBackClicked" Style="{StaticResource NavigationBackButtonNormalStyle}"/>
            <TextBlock Text="Historique complet des transactions" 
                       FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <ListView Grid.Row="1" SelectionMode="None" BorderThickness="1" BorderBrush="#11000000" CornerRadius="8">
            <ListView.Items>
                <ListViewItem>
                    <Grid Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Width="60">
                            <TextBlock Text="02 Déc" FontWeight="Bold"/>
                            <TextBlock Text="14:30" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock Text="Supermarché Carrefour" FontWeight="SemiBold"/>
                            <TextBlock Text="Alimentation" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="- 54,30 €" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </ListViewItem>

                <ListViewItem>
                    <Grid Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Width="60">
                            <TextBlock Text="01 Déc" FontWeight="Bold"/>
                            <TextBlock Text="09:00" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock Text="Virement Salaire" FontWeight="SemiBold"/>
                            <TextBlock Text="Employeur" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="+ 2 100,00 €" Foreground="Green" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </ListViewItem>

                <ListViewItem>
                    <Grid Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Width="60">
                            <TextBlock Text="28 Nov" FontWeight="Bold"/>
                            <TextBlock Text="18:45" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock Text="Loyer Décembre" FontWeight="SemiBold"/>
                            <TextBlock Text="Virement permanent" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="- 650,00 €" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </ListViewItem>

                <ListViewItem>
                    <Grid Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Width="60">
                            <TextBlock Text="15 Nov" FontWeight="Bold"/>
                            <TextBlock Text="12:00" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock Text="Netflix" FontWeight="SemiBold"/>
                            <TextBlock Text="Abonnement" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="- 17,99 €" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </ListViewItem>

            </ListView.Items>
        </ListView>
    </Grid>
</Page>
