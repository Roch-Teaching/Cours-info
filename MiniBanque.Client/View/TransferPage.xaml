<Page
    x:Class="MiniBanque.Client.View.TransferPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiniBanque.Client.View"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <StackPanel MaxWidth="400" Spacing="20" VerticalAlignment="Center">

            <TextBlock Text="Effectuer un virement" 
                       FontSize="28" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <ComboBox x:Name="SourceAccountCombo" 
                      Header="Compte à débiter" 
                      PlaceholderText="Sélectionnez un compte"
                      HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Compte Courant (1 250 €)" IsSelected="True"/>
                <ComboBoxItem Content="Livret A (4 000 €)"/>
            </ComboBox>

            <TextBox x:Name="DestinationAccountBox" 
                     Header="Compte destinataire (ID ou Email)" 
                     PlaceholderText="Ex: 42 ou ami@mail.com"/>

            <NumberBox x:Name="AmountBox" 
                       Header="Montant (€)" 
                       PlaceholderText="0.00"
                       Minimum="0"
                       SpinButtonPlacementMode="Inline"/>

            <TextBox x:Name="DescriptionBox" 
                     Header="Motif du virement" 
                     PlaceholderText="Ex: Remboursement resto"/>

            <Grid ColumnSpacing="10" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="Annuler" 
                        HorizontalAlignment="Stretch"
                        Click="OnCancelClicked"/>

                <Button Grid.Column="1" 
                        Content="Valider" 
                        Style="{StaticResource AccentButtonStyle}" 
                        HorizontalAlignment="Stretch"
                        Click="OnTransferClicked"/>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
