<Page
    x:Class="MiniBanque.Client.View.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiniBanque.Client.View"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Bonjour, Utilisateur" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Bienvenue sur votre espace client" Opacity="0.6"/>
            </StackPanel>
            <Button Content="Se déconnecter" Click="OnLogoutClicked" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="20">

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="SOLDE TOTAL" Opacity="0.8" FontSize="12"/>
                        <TextBlock Text="5 250,00 €" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentAaTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Mes Comptes" FontWeight="SemiBold" FontSize="18"/>

                <ListView SelectionMode="None" BorderThickness="1" BorderBrush="#11000000" CornerRadius="8">
                    <ListView.Items>
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal" Spacing="16" Padding="12">
                                <FontIcon Glyph="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="24"/>
                                <StackPanel Width="150">
                                    <TextBlock Text="Compte Courant" FontWeight="Bold"/>
                                    <TextBlock Text="**** 1234" FontSize="12" Opacity="0.5"/>
                                </StackPanel>
                                <TextBlock Text="1 250,00 €" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <ListViewItem>
                            <StackPanel Orientation="Horizontal" Spacing="16" Padding="12">
                                <FontIcon Glyph="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="24"/>
                                <StackPanel Width="150">
                                    <TextBlock Text="Livret A" FontWeight="Bold"/>
                                    <TextBlock Text="**** 5678" FontSize="12" Opacity="0.5"/>
                                </StackPanel>
                                <TextBlock Text="4 000,00 €" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>
                    </ListView.Items>
                </ListView>

                <Button Content="Effectuer un virement" 
                        Click="OnNewTransferClicked"
                        HorizontalAlignment="Stretch" 
                        Style="{StaticResource AccentButtonStyle}"
                        Height="40"/>

                <Button Content="Ouvrir un compte"
                        Click="OnCreateAccountClicked"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="40"/>
            </StackPanel>


            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Aperçu du mois" FontWeight="SemiBold" Opacity="0.6"/>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Entrées" FontSize="12" Opacity="0.6"/>
                                <TextBlock Text="+ 2 100 €" Foreground="Green" FontWeight="Bold" FontSize="18"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Sorties" FontSize="12" Opacity="0.6"/>
                                <TextBlock Text="- 704,30 €" Foreground="Red" FontWeight="Bold" FontSize="18"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Background="#11000000" Padding="10,5" CornerRadius="4">
                                <TextBlock Text="3 Ops" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <Grid Height="12" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="Green" Opacity="0.8"/>
                            <Rectangle Grid.Column="1" Fill="Red" Opacity="0.8"/>
                        </Grid>

                        <TextBlock Text="Ratio Dépenses / Revenus" FontSize="10" HorizontalAlignment="Center" Opacity="0.4"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Dernières Transactions" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" 
                            Content="Voir tout l'historique" 
                            FontSize="12" 
                            Background="Transparent" 
                            Click="OnSeeAllHistoryClicked"/>
                </Grid>

                <ListView Grid.Row="2" SelectionMode="None" BorderThickness="1" BorderBrush="#11000000" CornerRadius="8">
                    <ListView.Items>

                        <ListViewItem>
                            <Grid Padding="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Width="60">
                                    <TextBlock Text="02 Déc" FontWeight="Bold"/>
                                    <TextBlock Text="14:30" FontSize="11" Opacity="0.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="Supermarché Carrefour" FontWeight="SemiBold"/>
                                    <TextBlock Text="Alimentation" FontSize="12" Opacity="0.6"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="- 54,30 €" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </ListViewItem>

                        <ListViewItem>
                            <Grid Padding="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Width="60">
                                    <TextBlock Text="01 Déc" FontWeight="Bold"/>
                                    <TextBlock Text="09:00" FontSize="11" Opacity="0.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="Virement Salaire" FontWeight="SemiBold"/>
                                    <TextBlock Text="Employeur" FontSize="12" Opacity="0.6"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="+ 2 100,00 €" Foreground="Green" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </ListViewItem>

                        <ListViewItem>
                            <Grid Padding="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Width="60">
                                    <TextBlock Text="28 Nov" FontWeight="Bold"/>
                                    <TextBlock Text="18:45" FontSize="11" Opacity="0.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="Loyer Décembre" FontWeight="SemiBold"/>
                                    <TextBlock Text="Virement permanent" FontSize="12" Opacity="0.6"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="- 650,00 €" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </ListViewItem>

                    </ListView.Items>
                </ListView>
            </Grid>

        </Grid>
    </Grid>
</Page>
