<Page
    x:Class="MiniBanque.Client.View.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiniBanque.Client.View"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="Page_Loaded">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock x:Name="GreetingTextBlock" Text="Bonjour, Utilisateur" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Bienvenue sur votre espace client" Opacity="0.6"/>
            </StackPanel>
            <Button Content="Actualiser" Click=" OnRefreshClicked" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <Button Content="Se déconnecter" Click="OnLogoutClicked" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="20">

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="SOLDE TOTAL" Opacity="0.8" FontSize="12"/>
                        <TextBlock x:Name="TotalBalanceTextBlock" Text="0,00 €" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentAaTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Mes Comptes" FontWeight="SemiBold" FontSize="18"/>

                <ListView x:Name="AccountsListView" SelectionMode="None" BorderThickness="1" BorderBrush="#11000000" CornerRadius="8"/>

                <Button Content="Effectuer un virement" 
                        Click="OnNewTransferClicked"
                        HorizontalAlignment="Stretch" 
                        Style="{StaticResource AccentButtonStyle}"
                        Height="40"/>

                <Button Content="Ouvrir un compte"
                        Click="OnCreateAccountClicked"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="40"/>
            </StackPanel>


            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Aperçu du mois" FontWeight="SemiBold" Opacity="0.6"/>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Entrées" FontSize="12" Opacity="0.6"/>
                                <TextBlock x:Name="EntriesTextBlock" Text="+ 0,00 €" Foreground="Green" FontWeight="Bold" FontSize="18"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Sorties" FontSize="12" Opacity="0.6"/>
                                <TextBlock x:Name="ExitsTextBlock" Text="- 0,00 €" Foreground="Red" FontWeight="Bold" FontSize="18"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Background="#11000000" Padding="10,5" CornerRadius="4">
                                <TextBlock x:Name="OpsTextBlock" Text="0 Ops" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="RatioGrid" Height="12" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="Green" Opacity="0.8"/>
                            <Rectangle Grid.Column="1" Fill="Red" Opacity="0.8"/>
                        </Grid>

                        <TextBlock Text="Ratio Dépenses / Revenus" FontSize="10" HorizontalAlignment="Center" Opacity="0.4"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Dernières Transactions" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" 
                            Content="Voir tout l'historique" 
                            FontSize="12" 
                            Background="Transparent" 
                            Click="OnSeeAllHistoryClicked"/>
                </Grid>

                <ListView x:Name="TransactionsListView" Grid.Row="2" SelectionMode="None" BorderThickness="1" BorderBrush="#11000000" CornerRadius="8"/>
            </Grid>

        </Grid>
    </Grid>
</Page>
